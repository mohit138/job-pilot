#!/bin/sh
# Blocks commits that would publish personal data. See scripts/check-private.ts.
# Git runs hooks with a bare PATH, so also look where the Bun installer puts bun.
BUN=$(command -v bun || echo "$HOME/.bun/bin/bun")
if [ ! -x "$BUN" ]; then
  echo "pre-commit: bun not found; install it from https://bun.sh so the privacy check can run." >&2
  exit 1
fi
exec "$BUN" run scripts/check-private.ts
